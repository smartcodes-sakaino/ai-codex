# このファイルをコピーして「.env」という名前で保存し、値を埋めてください。
# 前後の引用符(" や ')は含めず、値だけを貼り付けてください。

# サーバーを動かすポート番号(通常は変更不要)
PORT=5000

# データベース接続情報(既存のPostgreSQLの接続文字列)
DATABASE_URL=

# Gemini(Google AI)のAPIキー
# 取得先: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 画像・ファイル保存用のGoogle Drive設定
# サービスアカウントキー(JSONファイル)を保存した場所へのパス
GOOGLE_APPLICATION_CREDENTIALS=

# 画像を保存するGoogle DriveフォルダのID(フォルダの共有URLに含まれる文字列)
DRIVE_IMAGES_FOLDER_ID=

# 動画を保存するGoogle DriveフォルダのID(フォルダの共有URLに含まれる文字列)
DRIVE_VIDEOS_FOLDER_ID=

# 配布用ファイル(zipなど)を保存するGoogle DriveフォルダのID(フォルダの共有URLに含まれる文字列)
DRIVE_FILES_FOLDER_ID=

# ログインセッションの暗号化に使う鍵(ランダムな長い文字列を設定してください)
SESSION_SECRET=
